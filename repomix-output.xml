            {
                var name = package.Name;
                var version = package.Version;
                var creator = $"<color=#B0E0E6>RITC扩展包 - {name}</color>";

                //捋一捋
                //缺了兑换码, sloticon示例, 标靶示例, 装修示例, 弹挂布局示例
                //诶呦, 遥遥无期哟
                //得从隔壁火神重工扒拉点资源过来
                //反正我把重复警告杀了
